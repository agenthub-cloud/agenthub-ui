{
  "name": "@agenthub-cloud/ui",
  "version": "0.2.1",
  "description": "AgentHub 多端 UI SDK：聊天、会话、工作区、文件、知识库与资源页面",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "default": "./dist/pages.js"
    },
    "./tokens.scss": "./dist/tokens/ai-tokens.scss",
    "./theme.css": "./dist/theme.css",
    "./css": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.css"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "dev": "vite playground",
    "build": "vite build && npm run build:css && npm run build:types",
    "build:css": "sass src/tokens/ah-scope.scss dist/theme.css --no-source-map && mkdir -p dist/tokens && cp src/tokens/ai-tokens.scss dist/tokens/",
    "build:types": "cp src/index.d.ts dist/index.d.ts && cp src/pages.d.ts dist/pages.d.ts",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "@agenthub-cloud/chat": ">=0.2.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@agenthub-cloud/chat": "^0.2.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^29.1.1",
    "sass": "^1.77.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "three-spritetext": "^1.10.0"
  }
}

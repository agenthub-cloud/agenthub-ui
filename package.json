{
  "name": "@agenthub-cloud/ui",
  "version": "0.1.1",
  "description": "AgentHub 聊天 UI 原子组件库:三端共用的聊天表面/会话/工作区组件与设计令牌",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.scss": "./dist/tokens/ai-tokens.scss",
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "dev": "vite playground",
    "build": "vite build && npm run build:css",
    "build:css": "sass src/tokens/ah-scope.scss dist/theme.css --no-source-map && mkdir -p dist/tokens && cp src/tokens/ai-tokens.scss dist/tokens/",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "@agenthub-cloud/chat": ">=0.1.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@agenthub-cloud/chat": "^0.1.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^29.1.1",
    "sass": "^1.77.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "dependencies": {
    "marked": "^18.0.7",
    "dompurify": "^3.4.12"
  }
}
